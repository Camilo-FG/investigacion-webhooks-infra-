# Opcional con Docker: sin .env, docker compose usa valores de demostración y el PostgreSQL local.
# Para cambiarlos, copia este archivo como .env (el .env no se sube al repo).
# Sin Docker (run-local.ps1 / npm) sí hace falta: completa HMAC_SECRET y DATABASE_URL.

# Clave HMAC compartida: debe ser idéntica en service-a y service-b. Vacía = la de demostración.
HMAC_SECRET=

# Puertos del host
PORT_A=3000
PORT_B=3001
PORT_FRONTEND=8080

# PostgreSQL. Vacía = la base local del contenedor db (solo con Docker).
# Para usar Supabase: postgresql://postgres.<proyecto>:<contraseña>@<host>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Fake Payment Provider (service-b)
PROCESSING_DELAY_MS=3000
DEFERRED_THRESHOLD=50000

# Solo sin Docker: cómo se encuentran los servicios en tu máquina.
# En Docker se ignoran, porque docker-compose usa los nombres service-a y service-b.
SERVICE_B_URL=http://localhost:3001
DEFAULT_WEBHOOK_URL=http://localhost:3000/webhooks/payments

# ONVO (pagos reales de prueba, Demo 2). Claves del Dashboard de ONVO en modo prueba (onvo_test_...).
# Nunca uses claves onvo_live_ ni subas el .env al repo.
# La secreta no sale de Service A; la publicable sí va al navegador (la usa el SDK de ONVO).
ONVO_SECRET_KEY=
ONVO_PUBLISHABLE_KEY=
# El Dashboard de ONVO la muestra al registrar la URL pública https://<tu-dominio>/webhooks/onvo
ONVO_WEBHOOK_SECRET=
# true: ante cada webhook, Service A consulta el Payment Intent a ONVO y esa respuesta manda.
# Poner false solo para pruebas locales sin acceso a ONVO.
ONVO_VERIFY_EVENTS=true
