# Copia este archivo como .env y completa los valores reales (el .env no se sube al repo).
# Sirve para los dos modos: Docker (run.ps1 / run.sh) y sin Docker (run-local.ps1 / npm).

# Shared HMAC secret — MUST be identical for service-a and service-b
HMAC_SECRET=mi-secreto-compartido

# Host ports
PORT_A=3000
PORT_B=3001
PORT_FRONTEND=8080

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.[SUPABASE-PROJECT].supabase.co:6543/postgres

# Fake Payment Provider (service-b)
PROCESSING_DELAY_MS=3000
DEFERRED_THRESHOLD=50000

# Solo sin Docker: cómo se encuentran los servicios en tu máquina.
# En Docker se ignoran, porque docker-compose usa los nombres service-a y service-b.
SERVICE_B_URL=http://localhost:3001
DEFAULT_WEBHOOK_URL=http://localhost:3000/webhooks/payments

# ONVO integration (Persona 3: complete these)
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
